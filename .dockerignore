# Git history (likely the 900MB culprit)
.git
.gitignore

# Python Environments
.venv
venv
env

# Cache and Bytecode
__pycache__
*.pyc
.pytest_cache
.mypy_cache

# Environment variables (Safety risk!)
.env
.env.local

# IDE settings
.vscode
.idea

# Large build artifacts or logs
build
dist
*.log
*.sqlite3

# If you have a frontend folder inside, ignore its dependencies
node_modules

# Ignore .git recursively (Critical for your size issue)
**/.git
**/.gitignore

# Ignore pycache recursively
**/__pycache__
**/*.pyc

# Ignore envs recursively
**/.env
**/.venv
**/venv
**/env

# Ignore logs/caches
**/*.log
**/.pytest_cache
**/.mypy_cache