{% comment %}
  Render once in theme.liquid before </body>. Upload the accompanying JS to Assets.
  No customer ID/phone supplied by this theme is trusted by the backend.
{% endcomment %}
{% if customer %}
  <aside id="heidel-cart-recovery" data-customer="{{ customer.id }}" data-proxy="/apps/heidelai/cart">
    <label>
      <input type="checkbox" id="heidel-cart-consent">
      Send me a WhatsApp reminder about items I leave in my cart, using the phone number in my store account. I can opt out by replying STOP.
    </label>
    <span id="heidel-cart-status" role="status" aria-live="polite"></span>
  </aside>
  <script src="{{ 'heidel-cart-recovery.js' | asset_url }}" defer></script>
{% endif %}
